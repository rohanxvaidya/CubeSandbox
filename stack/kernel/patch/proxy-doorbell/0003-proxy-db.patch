From 466cafe4f4a893e2197834a1d269925df0d362bd Mon Sep 17 00:00:00 2001
From: root <root@gnr-bkc.sh.intel.com>
Date: Fri, 21 Feb 2025 02:41:28 -0500
Subject: [PATCH 3/3] proxy db

---
 Makefile                                          |  4 ++--
 drivers/net/ethernet/mellanox/mlx5/core/en_txrx.c | 12 ++++++++----
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/Makefile b/Makefile
index 210c3c5bbbb8..8d1506cd3fb7 100644
--- a/Makefile
+++ b/Makefile
@@ -1,8 +1,8 @@
 # SPDX-License-Identifier: GPL-2.0
 VERSION = 6
 PATCHLEVEL = 8
-SUBLEVEL = 0
-EXTRAVERSION = -lock-in-mlx2
+SUBLEVEL = 100
+EXTRAVERSION = -proxy-cpu-lock-in-mlx
 NAME = Hurr durr I'ma ninja sloth
 
 # *DOCUMENTATION*
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_txrx.c b/drivers/net/ethernet/mellanox/mlx5/core/en_txrx.c
index bd9dcd0ba162..33b44d06d0e1 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_txrx.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_txrx.c
@@ -178,7 +178,7 @@ static noinline void mlx5e_cq_arms_handle(struct mlx5e_channel *c)
 
 }
 
-#define proxy_db_cpu	64
+#define proxy_db_cpu 64
 long long db_counter2 = 1;
 /* revisit, smp_call_function_single should be enough for atomic mailbox! */
 static void mlx5_db_action_func(void *info)
@@ -216,12 +216,12 @@ static void mlx5_db_action_func(void *info)
 
 }
 
-static inline void call_cpu_proxy_handler(int cpu)
+static inline void call_cpu_proxy_handler(int proxy_cpu)
 {
 	int wait = 0;
 
 	struct nic_common_doorbell * current_db_action = this_cpu_ptr(&mlx_common_doorbell_queue);
-	smp_call_function_single(proxy_db_cpu, mlx5_db_action_func, current_db_action, wait);
+	smp_call_function_single(proxy_cpu, mlx5_db_action_func, current_db_action, wait);
 }
 
 //Handle one doorbell request;
@@ -636,7 +636,11 @@ int mlx5e_napi_poll(struct napi_struct *napi, int budget)
 		struct nic_common_doorbell * current_db_action = this_cpu_ptr(&mlx_common_doorbell_queue);
 		current_db_action->cpu_idx = current_cpu;
 		mlx5_fill_doorbell_notify(c, current_db_action);
-		call_cpu_proxy_handler(current_cpu);
+		int proxy_cpu = proxy_db_cpu;
+		if (mlx_proxy_db > 0) {
+		    proxy_cpu = mlx_proxy_db -1;
+		}
+		call_cpu_proxy_handler(proxy_cpu);
 	}
 
 	// Put lock prefix or serialize instruction AFTER MMIO ops
