+//Handle one doorbell request;
+static inline void mlx5_doorbell_update(struct mlx_db_action *db_action)
+{
+	
+	//*mcq->arm_db = cmd_arm_db;
+	*db_action->arm_db = db_action->doorbell[0];
+
+	/* Make sure that the doorbell record in host memory is
+	* written before ringing the doorbell via PCI MMIO.
+	*/
+	wmb();
+
+	// db_action->doorbell[0] = cpu_to_be32(sn << 28 | cmd | ci);
+	// db_action->doorbell[1] = cpu_to_be32(mcq->cqn);
+
+	mlx5_write64(db_action->doorbell, db_action->db_address);
+	//if (db_counter%100000000 == 0)
+	//pr_info("update : db0=%d, db1=%d,\n", db_action->doorbell[0], db_action->doorbell[1]);
