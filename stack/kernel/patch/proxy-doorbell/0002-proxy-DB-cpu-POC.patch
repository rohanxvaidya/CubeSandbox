+// used for polling and update. 
+void mlx_proxy_doorbell_update(void)
+{
+	int cpu;
+	int core = mlx_proxy_db_flag_get();
+
+	printk(KERN_INFO "Start the proxy DB thread, %s, on cpu[%d]\n",__func__, core);
+
+	if (mlx_proxy_db)
+		mlx_proxy_enable = true;
+
+	while( mlx_proxy_enable) {
+
+		for_each_online_cpu(cpu) {
+			//struct nic_common_doorbell * db_action_node = (struct nic_common_doorbell *)&per_cpu(mlx_common_doorbell_queue, cpu);
+			struct nic_common_doorbell db_action_node = per_cpu(mlx_common_doorbell_queue, cpu);
+
+			if (db_action_node.cpu_idx != cpu ) {
+				if (count1++ % 10000000 == 0)
+					printk(KERN_INFO "invalid for cpu_node[%d]\n", cpu);
+				continue;
+			}
+			if ( db_action_node.status == DB_NEW ) {
+				//handle the doorbell request
+				// if (db_counter%10000000 == 0)
+				// 	printk(KERN_INFO "node[%d], status : %d\n", cpu, db_action_node.status );
+
+				mlx5_doorbell_update(&db_action_node.rq_cq);
+				mlx5_doorbell_update(&db_action_node.icosq_cq);
+				mlx5_doorbell_update(&db_action_node.async_icosq_cq);
+				mlx5_doorbell_update(&db_action_node.xdpsq_cq);
+				db_counter++;
+				db_action_node.status = DB_EMPTY;
+			}
+		}
+		yield();
+		asm volatile("rep; nop");
+		//cpu_relax();
+		//db_counter++;
+		//if (db_counter%10000000 == 0)
+		//	printk(KERN_INFO "Request db_counter : %llu \n", db_counter);
+		//usleep(1); 
+		udelay(1);
+	}
+
+	msleep(1000);  // sleep 1s .
+}
