+static int proxy_db_enable_show(struct seq_file *file, void *priv)
+{
+	struct mlx5_core_dev *dev = file->private;
+	struct mlx5_lag *ldev;
+	int flag;
+
+	ldev = mlx5_lag_dev(dev);
+	mutex_lock(&ldev->lock);
+	flag = mlx_proxy_db_flag_get();
+	mutex_unlock(&ldev->lock);
+
+	seq_printf(file, "%d\n", flag);
+
+	return 0;
+}
+
+static ssize_t proxy_db_enable_write(struct file *file, const char __user *userbuf, size_t count, loff_t *ppos)
+{
+	struct seq_file *seq_f = file->private_data;
+	struct mlx5_core_dev *dev = seq_f->private;
+	struct mlx5_lag *ldev;
+	int v, flag, ret;
+
+	ret = kstrtou32_from_user(userbuf, count, 10, &v);
+	if (ret)
+		return ret;
+
+	ldev = mlx5_lag_dev(dev);
+
+
+	if (v) {
+		printk(KERN_INFO "Start the DB proxy funtion... \n");
+		mutex_lock(&ldev->lock);
+		mlx_proxy_db_flag_set(v);
+		mutex_unlock(&ldev->lock);
+        //schedule_work(&dev->update_db_work);      // Start the operation loop
+		start_db_thread_function();
+	} else {
+		printk(KERN_INFO "Stop the DB proxy funtion... \n");
+		mutex_lock(&ldev->lock);
+		mlx_proxy_db_flag_set(v);
+		mutex_unlock(&ldev->lock);
+
+        //cancel_work_sync(&dev->update_db_work);      // stop the operation loop
+		stop_db_thread_function();
+
+
+
+	}
+	return count;
+}
