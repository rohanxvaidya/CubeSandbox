+// Thread function 
+static int thread_db_fn(void *data)
+{
+
+    while (!kthread_should_stop()) {
+        //mlx_proxy_doorbell_update();
+		yield();
+		msleep(1000);
+    }
+
+    pr_info("Thread doorbell loop exit...");
+    return 0;
+}
+
+// Function to stop threads
+void stop_db_thread_function(void)
+{
+    threads_should_stop = true;
+	mlx_proxy_enable = false;
+	msleep(10);
+    // Stop the worker threads
+    if (thread_db)
+        kthread_stop(thread_db);
+
+    pr_info("Threads stopped\n");
+}
+
+// Function to start threads
+int start_db_thread_function(void)
+{
+    int thread_count = 1, core_index = mlx_proxy_db_flag_get();
+    int num_cpus = num_online_cpus(); // Get the number of online CPUs
+
+    if (thread_count <= 0) {
+        pr_err("thread_count is not set or is invalid\n");
+        return -EINVAL;
+    }
+
+	if (core_index <= 0) {
+		pr_err("core index is not set or is invalid\n");
+        return -EINVAL;
+	} 
+return 0;
+	nic_common_db_init();
+
+    threads_should_stop = false;
+    pr_info("Start to run thread...");
+    // Start the worker threads
+    thread_db = kthread_create(thread_db_fn, NULL, "thread_proxy_db");
+    if (IS_ERR(thread_db)) {
+        pr_err("thread_proxy_db: failed to create thread\n");
+        return PTR_ERR(thread_db);
+    }
+
+    // Pin the thread to a specific CPU in round-robin fashion
+    kthread_bind(thread_db, (core_index - 1) % num_cpus);
+
+    // Start the thread
+    wake_up_process(thread_db);
+
+    pr_info("Threads started (thread_count = %d)\n", thread_count);
+    return 0;
+}
