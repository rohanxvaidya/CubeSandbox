+static inline void mlx5e_cq_arm_fill(struct mlx5e_cq *cq, struct mlx_db_action *db_action)
+{
+	struct mlx5_core_cq *mcq;
+	u32 cmd = MLX5_CQ_DB_REQ_NOT;
+    void __iomem *uar_page;
+	void __iomem *doorbell_reg;
+    u32 cons_index;
+
+	mcq = &cq->mcq;
+
+	uar_page = mcq->uar->map;
+	cons_index = cq->wq.cc;
+
+	//__be32 doorbell[2];
+	u32 sn;
+	u32 ci;
+	__be32 cmd_arm_db;
+
+	sn = mcq->arm_sn & 3;
+	ci = cons_index & 0xffffff;
+
+	cmd_arm_db	= cpu_to_be32(sn << 28 | cmd | ci);
+
+	//*mcq->arm_db = cmd_arm_db;
+	db_action->arm_db = mcq->arm_db;
+
+	/* Make sure that the doorbell record in host memory is
+	 * written before ringing the doorbell via PCI MMIO.
+	 */
+	//wmb();
+
+	// doorbell[0] = cpu_to_be32(sn << 28 | cmd | ci);
+	// doorbell[1] = cpu_to_be32(mcq->cqn);
+	db_action->doorbell[0] = cpu_to_be32(sn << 28 | cmd | ci);
+	db_action->doorbell[1] = cpu_to_be32(mcq->cqn);
+// db_counter++;
+// if (db_counter%1000000 == 0)
+// 	pr_info("fill: db0=%d, db1=%d,", db_action->doorbell[0], db_action->doorbell[1]);
+
+	doorbell_reg = uar_page + MLX5_CQ_DOORBELL;
+	db_action->db_address = doorbell_reg;
+	//mlx5_write64(doorbell, uar_page + MLX5_CQ_DOORBELL);
+}
