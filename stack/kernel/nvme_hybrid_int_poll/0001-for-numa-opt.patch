+/**
+ * nvme_get_bio_numa_node - Get the NUMA node ID of a bio's buffer
+ * @bio: bio structure to analyze
+ * 
+ * This function samples the first few pages of the bio to determine the NUMA node.
+ * It's optimized for performance by limiting the number of pages sampled.
+ * Returns: NUMA node ID, or NUMA_NO_NODE if cannot determine
+ */
+static int nvme_get_bio_numa_node(struct request *req)
+{
+    struct bio_vec bvec;
+    struct bvec_iter iter;
+	struct bio *bio = req->bio;
+	struct nvme_queue *nvmeq = req->mq_hctx->driver_data;
+	struct nvme_dev *dev = nvmeq->dev;
+
+	int first_valid_node = NUMA_NO_NODE;
+    int sampled_pages = 0;
+    const int max_samples = 3; // check first 3 pages.
+    
+	if (!bio || !bio_has_data(bio)) {
+        dev_dbg(dev->dev, "bio is NULL or has no data, cannot determine NUMA node\n");
+        return NUMA_NO_NODE;
+    }
+    
+    bio_for_each_segment(bvec, bio, iter) {
+        struct page *page = bvec.bv_page;
+        int page_numa;
+        
+        // if (PageSlab(page) || PageCompound(page))
+        //     continue;
+		
+		// Skip special pages that cannot provide accurate NUMA information
+        if (PageSlab(page)) {
+            dev_dbg(dev->dev, "Page %d: slab page, skipping NUMA node check\n", sampled_pages);
+            continue;
+        }
+        
+        if (PageCompound(page)) {
+			// dev_dbg(dev->dev,"Page %d: compound page, skipping NUMA node check\n", sampled_pages);
+            // continue;
+
+			// Some pages is compund page, etc, HP, THP, that might cross NUMA.
+			struct page *head = compound_head(page);
+            page_numa = page_to_nid(head);
+
+            // dev_dbg(dev->dev,  "Compound page detected, using head page NUMA node: %d\n", page_numa);
+            // dev_dbg(dev->dev,  "Compound page order: %d, nr_pages: %d\n", 
+            //         compound_order(page), compound_nr(page));
+
+            if (compound_nr(page) > 1) {
+                dev_dbg(dev->dev, "WARNING: Compound page has %d subpages, may span multiple NUMA nodes\n",
+                        compound_nr(page));
+            }
+
+        }
+	
+        page_numa = page_to_nid(page);
+        if (page_numa == NUMA_NO_NODE)
+            continue;
+        
+        if (first_valid_node == NUMA_NO_NODE) {
+            first_valid_node = page_numa;
+        } else if (page_numa != first_valid_node) {
+            // pages has cross NUMa nodes.
+			dev_dbg(dev->dev, "WARNING: Page %d is on different NUMA node: %d (expected: %d)\n",
+                    sampled_pages, page_numa, first_valid_node);
+			return first_valid_node;
+        }
+
+        sampled_pages++;
+        if (sampled_pages >= max_samples)
+            break;
+    }
+    
+    return first_valid_node;
+}
