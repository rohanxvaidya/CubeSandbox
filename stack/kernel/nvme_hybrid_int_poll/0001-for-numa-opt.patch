+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+	struct nvme_command *cmnd = &iod->cmd;
+
+	pr_debug("Entry %s ..., numa_opt set enalbed? %s\n", __FUNCTION__, iod->numa_opt.enabled?"YES":"NO");
+
+	if (iod->numa_opt.enabled) {
+	//if (numa_opt_enabled) {
+        struct page *page = virt_to_page(iod->numa_opt.numa_local_buffer);
+        int buffer_node = page_to_nid(page);
+        int dev_node = dev_to_node(dev->dev);
+        
+        dev_dbg(dev->dev, "DMA NUMA info: buffer_node=%d, dev_node=%d, same_node=%d\n",
+                buffer_node, dev_node, buffer_node == dev_node);
+
+        dev_dbg(dev->dev, "DMA addresses: local_dma=0x%llx, prp1=0x%llx\n",
+                iod->numa_opt.numa_local_dma, 
+                le64_to_cpu( cmnd->rw.dptr.prp1));
+
+		phys_addr_t phys_addr = virt_to_phys(iod->numa_opt.numa_local_buffer);
+        dev_info(dev->dev, "  Physical addr: 0x%llx\n", phys_addr);
+
+
+		if (cmnd->rw.dptr.prp2) {
+			dma_addr_t prp2 = le64_to_cpu(cmnd->rw.dptr.prp2);
+			dev_dbg(dev->dev, "PRP2:               0x%llx\n", prp2);
+		} else {
+			dev_dbg(dev->dev, "PRP2:               NULL\n");
+		}
+		
+		if (iod->nr_allocations > 0) {
+			dev_dbg(dev->dev, "Using PRP list:      YES (%d allocations)\n", 
+					iod->nr_allocations);
+		}
+
+
+		dev_info(dev->dev, "=== sg_table Debug ===\n");
+		dev_info(dev->dev, "sgt.sgl:        %p\n", iod->sgt.sgl);
+		dev_info(dev->dev, "sgt.nents:      %d\n", iod->sgt.nents);
+		//dev_info(dev->dev, "numa_opt.original_sgt: %p\n", iod->numa_opt.original_sgt);
+		
+		if (iod->sgt.sgl) {
+			struct scatterlist *sg = iod->sgt.sgl;
+			dev_info(dev->dev, "sg_dma_address:  0x%llx\n", sg_dma_address(sg));
+			dev_info(dev->dev, "sg_length:      %u\n", sg->length);
+			dev_info(dev->dev, "sg_page:        %p\n", sg_page(sg));
+		}
+
+	}
+	dev_info(dev->dev, "--- final confirm sg data ---\n");
+	nvme_print_sgl(iod->sgt.sgl, iod->sgt.nents);
+}
