+// config NUMA OPT structure.
+static blk_status_t nvme_setup_numa_optimization(struct nvme_dev *dev,
+                                                struct request *req,
+												struct nvme_command *cmnd,
+                                                int dev_numa_node)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+	struct bio *bio = req->bio;
+    size_t io_size = blk_rq_bytes(req);
+    gfp_t gfp_mask = GFP_ATOMIC | __GFP_THISNODE;
+	blk_status_t ret;
+
+	if (iod->numa_opt.enabled)
+		return BLK_STS_OK;
+
+	memset(&iod->numa_opt, 0, sizeof(iod->numa_opt));
+
+	// dev_info(dev->dev, "--- initially print sg data ---\n");
+	// nvme_print_sgl(iod->sgt.sgl, iod->sgt.nents);
+
+	// 1. backup orginal bio
+    memcpy(&iod->numa_opt.original_sgt, &iod->sgt, sizeof(iod->sgt));
+    iod->numa_opt.original_numa_node = nvme_get_bio_numa_node(req);
+    iod->numa_opt.buffer_size = io_size;
+    
+    // 2. allocate new buffer on local NUMa.
+    iod->numa_opt.numa_local_buffer = kmalloc_node(io_size, gfp_mask, dev_numa_node);
+    if (!iod->numa_opt.numa_local_buffer) {
+        dev_warn(dev->dev, "NUMA optimization: failed to allocate local buffer\n");
+		iod->numa_opt.enabled = false;
+		return BLK_STS_RESOURCE;
+    }
+    
+    // 3. Mapp the local NUMA buffer DMA.
+
+    // 
+    // unsigned long attrs = DMA_ATTR_NO_WARN;
+    // #ifdef DMA_ATTR_NUMA_AWARE
+    // attrs |= DMA_ATTR_NUMA_AWARE;
+    // #endif
+    // return dma_map_single_attrs(dev, iod->numa_opt.numa_local_buffer, io_size, DMA_BIDIRECTIONAL, attrs);
+
+
+	iod->numa_opt.numa_local_dma = dma_map_single(dev->dev,
+                                                iod->numa_opt.numa_local_buffer,
+                                                io_size, DMA_BIDIRECTIONAL);
+    if (dma_mapping_error(dev->dev, iod->numa_opt.numa_local_dma)) {
+        kfree(iod->numa_opt.numa_local_buffer);
+        dev_warn(dev->dev, "NUMA optimization: DMA mapping failed\n");
+		iod->numa_opt.enabled = false;
+        return BLK_STS_RESOURCE;
+    }
+    
+    // 4. sg list to local NUMA buffer.
+    struct scatterlist *opt_sg = kmalloc(sizeof(*opt_sg), GFP_ATOMIC);
+    if (!opt_sg) {
+        dma_unmap_single(dev->dev, iod->numa_opt.numa_local_dma, 
+                        io_size, DMA_FROM_DEVICE);
+        kfree(iod->numa_opt.numa_local_buffer);
+		dev_warn(dev->dev, "NUMA optimization: SG malloc failed.\n");
+		if (!dma_mapping_error(dev->dev, iod->numa_opt.numa_local_dma)) {
+			dma_unmap_single(dev->dev, iod->numa_opt.numa_local_dma,
+						iod->numa_opt.buffer_size, DMA_FROM_DEVICE);
+		}
+
+		iod->numa_opt.enabled = false;
+		return ret;
+    }
+    
+    sg_init_table(opt_sg, 1);
+    sg_set_buf(opt_sg, iod->numa_opt.numa_local_buffer, io_size);
+    
+    // 5. set new iod to local NUMA buffer.
+    iod->sgt.sgl = opt_sg;
+    iod->sgt.nents = 1;
+    iod->sgt.orig_nents = 1;
+    iod->numa_opt.enabled = true;
+
+    // 6. map the new sg_table.
+    iod->sgt.nents = dma_map_sg(dev->dev, iod->sgt.sgl, iod->sgt.nents,
+                               rq_data_dir(req));
+    if (iod->sgt.nents == 0) {
+		dev_warn(dev->dev, "NUMA optimization: dma map sg failed.\n");
+        nvme_cleanup_numa_opt_mapping(dev, req, iod);
+		iod->numa_opt.enabled = false;
+		return ret;
+    }
+    
+    // 7. setup prp for this new buffer.
+    ret = nvme_pci_setup_prps(dev, req, &cmnd->rw);
+    if (ret) {
+		dev_warn(dev->dev, "NUMA optimization: setup prps failed.\n");
+        nvme_cleanup_numa_opt_mapping(dev, req, iod);
+		iod->numa_opt.enabled = false;
+		return ret;
+    }
+
+	dev_dbg(dev->dev, "NUMA optimization: io_size=%zu, from node%d to node%d, mapped entries: %d\n",
+             io_size, iod->numa_opt.original_numa_node, dev_numa_node, iod->sgt.nents);
+	//pr_info( "NUMA optimization: io_size=%zu, from node%d to node%d\n",
+//			io_size, iod->numa_opt.original_numa_node, dev_numa_node);
+
+    return BLK_STS_OK;
+}
+
+static void nvme_copy_to_original_buffer(struct request *req, struct nvme_iod *iod)
+{
+	//struct bio *bio = req->bio;
+    struct scatterlist *sg;
+    int i;
+    void *src_ptr = iod->numa_opt.numa_local_buffer;
+    size_t copied = 0;
+    
+	pr_debug("Entry %s ...\n", __FUNCTION__);
+    // scan sg_table segments，copy all.
+    for_each_sg(iod->numa_opt.original_sgt.sgl, sg, 
+                iod->numa_opt.original_sgt.nents, i) {
+        struct page *page = sg_page(sg);
+        void *dst_ptr = kmap_atomic(page);
+        size_t len = sg->length;
+        
+        memcpy(dst_ptr + sg->offset, src_ptr + copied, len);
+        kunmap_atomic(dst_ptr);
+        
+        copied += len;
+    }
+}
