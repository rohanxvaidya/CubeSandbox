+// Checking the nvme opt condition.
+static bool nvme_should_optimize_numa(struct nvme_dev *dev, struct request *req,
+									 int dev_numa_node)
+{
+	struct bio *bio = req->bio;
+    size_t io_size = blk_rq_bytes(req);
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	if (!numa_opt_enabled)
+		return false;
+    // for > 128k IO.
+    if (io_size < 128 * 1024)
+        return false;
+	// only for READ ops.
+    if (rq_data_dir(req) != READ)
+        return false;
+
+	//numa check.
+    int bio_numa_node = nvme_get_bio_numa_node(req);
+	if (bio_numa_node == NUMA_NO_NODE)
+        return false;
+
+	//skip the local numa request.
+    if (bio_numa_node == dev_numa_node) {
+        return false;
+	}
+
+	// dev_dbg(dev->dev, "NUMA should optimized: io_size=%zu, io node%d device node%d\n",
+	// 		            io_size, bio_numa_node, dev_numa_node);
+
+	return true;
+}
