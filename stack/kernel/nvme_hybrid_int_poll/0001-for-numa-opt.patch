+// io completion for numa opt. should be called in nvme_pci_complete_rq();
+static void nvme_numa_opt_complete_rq(struct request *req)
+{
+//    struct nvme_dev *dev = req->q->queuedata;
+	struct nvme_queue *nvmeq = req->mq_hctx->driver_data;
+	struct nvme_dev *dev = nvmeq->dev;
+    struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	//pr_debug("Entry %s ...\n", __FUNCTION__);
+    if (iod->numa_opt.enabled) {
+
+		//pr_debug("numa opt completed: buffer_size=%zu,\n",iod->numa_opt.buffer_size); 
+		// 1.unmap the local numa DMA.
+		// will do it in unmap_data? assume it's done before.
+		// dma_unmap_sgtable(dev->dev, &iod->sgt, rq_dma_dir(req), 0);
+		if (iod->sgt.nents) {
+			dma_unmap_sg(dev->dev, iod->sgt.sgl, iod->sgt.nents,
+						rq_data_dir(req));
+		}
+		// 2. check blk_status_t or not? if IO error, there is no data to copy
+		// if read successfully, then copy data to original user buffer is OK.
+        if (rq_data_dir(req) == READ && numa_opt_nocopy == 0) {
+            nvme_copy_to_original_buffer(req, iod);
+        }
+
+		// 3 cleanup resource.
+		if (!dma_mapping_error(dev->dev, iod->numa_opt.numa_local_dma)) {
+        	dma_unmap_single(dev->dev, iod->numa_opt.numa_local_dma,
+            	           iod->numa_opt.buffer_size, DMA_FROM_DEVICE);
+    	}
+
+        // 3. free the local resource mapped for opt.
+		// -- a
+		if (iod->numa_opt.numa_local_buffer)
+	        kfree(iod->numa_opt.numa_local_buffer);
+        
+		// b. release sg table ???.
+		if (iod->sgt.sgl && iod->sgt.sgl != iod->numa_opt.original_sgt.sgl) {
+		 	kfree(iod->sgt.sgl);
+		}
+
+		// -- c. restore original table.????
+		memcpy(&iod->sgt, &iod->numa_opt.original_sgt, sizeof(iod->sgt));
+    
+		// ---d,
+		memset(&iod->numa_opt, 0, sizeof(iod->numa_opt));
+        iod->numa_opt.enabled = false;
+    }
+}
