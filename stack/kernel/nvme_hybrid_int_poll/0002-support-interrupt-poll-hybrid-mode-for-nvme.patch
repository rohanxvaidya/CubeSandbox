 		// 	debug_dma_numa_info(dev, req);
 		// }
 	}
+#if 1
+	if (nvme_irq_suppress && nvmeq) {
+		if (nvmeq->suppress_irq_count-- <= 0) {
+			pr_debug("irq_count = %d, set back to %d, Enable IRQ!\n", nvmeq->suppress_irq_count, nvme_irq_suppress);
+			
+//			spin_lock(&nvmeq->hybrid_poll_lock);
+//			nvmeq->suppress_irq_count = NVME_IRQ_SUPPRESS_COUNT;
+			nvmeq->suppress_irq_count = nvme_irq_suppress;
+			// enable irq;
+			if(nvmeq->irq_suppressed) {
+				spin_lock(&nvmeq->hybrid_poll_lock);
+				nvmeq->irq_suppressed = 0;
+				enable_irq(pci_irq_vector(pdev, nvmeq->cq_vector));
+				spin_unlock(&nvmeq->hybrid_poll_lock);
+			}
+		} else {
+			// disable irq
+			if(nvmeq->irq_suppressed == 0) {
+				spin_lock(&nvmeq->hybrid_poll_lock);
+				nvmeq->irq_suppressed = 1;
+				disable_irq(pci_irq_vector(pdev, nvmeq->cq_vector));
+				spin_unlock(&nvmeq->hybrid_poll_lock);
+			}
+		}
+	} else {
+		if (nvmeq->irq_suppressed) {
+			nvmeq->irq_suppressed = 0;
+			enable_irq(pci_irq_vector(pdev, nvmeq->cq_vector));
+		}
+	}
+#endif
+
 	nvme_write_sq_db(nvmeq, true);
 	spin_unlock(&nvmeq->sq_lock);
 }
@@ -1888,6 +1948,7 @@ static bool nvme_prep_rq_batch(struct nvme_queue *nvmeq, struct request *req)
 	return nvme_prep_rq(nvmeq->dev, req) == BLK_STS_OK;
 }
 
+static uint64_t nvme_q_rqs_list = 0;
 static void nvme_queue_rqs(struct rq_list *rqlist)
 {
 	struct rq_list submit_list = { };
@@ -1895,16 +1956,20 @@ static void nvme_queue_rqs(struct rq_list *rqlist)
 	struct nvme_queue *nvmeq = NULL;
 	struct request *req;
 
+	nvme_q_rqs_list = 0;
+
 	while ((req = rq_list_pop(rqlist))) {
 		if (nvmeq && nvmeq != req->mq_hctx->driver_data)
 			nvme_submit_cmds(nvmeq, &submit_list);
 		nvmeq = req->mq_hctx->driver_data;
 
-		if (nvme_prep_rq_batch(nvmeq, req))
+		if (nvme_prep_rq_batch(nvmeq, req)) {
 			rq_list_add_tail(&submit_list, req);
-		else
+			nvme_q_rqs_list++;
+		}else
 			rq_list_add_tail(&requeue_list, req);
 	}
+	pr_debug("Entry %s Current list count = %lld, in this submit\n", __FUNCTION__, nvme_q_rqs_list);
 
 	if (nvmeq)
 		nvme_submit_cmds(nvmeq, &submit_list);
@@ -2056,12 +2121,12 @@ static inline void nvme_update_cq_head(struct nvme_queue *nvmeq)
 		nvmeq->cq_head = tmp;
 	}
 }
-
+static uint64_t nvme_poll_count = 0;
 static inline bool nvme_poll_cq(struct nvme_queue *nvmeq,
 			        struct io_comp_batch *iob)
 {
 	bool found = false;
-
+	nvme_poll_count = 0;
 	while (nvme_cqe_pending(nvmeq)) {
 		found = true;
 		/*
@@ -2070,11 +2135,15 @@ static inline bool nvme_poll_cq(struct nvme_queue *nvmeq,
 		 */
 		dma_rmb();
 		nvme_handle_cqe(nvmeq, iob, nvmeq->cq_head);
+		nvme_poll_count++;
 		nvme_update_cq_head(nvmeq);
 	}
 
 	if (found)
 		nvme_ring_cq_doorbell(nvmeq);
+
+	pr_debug("Entry %s Current poll count = %lld, in this interrupt\n", __FUNCTION__, nvme_poll_count);
+	
 	return found;
 }
 
@@ -2086,6 +2155,17 @@ static irqreturn_t nvme_irq(int irq, void *data)
 	if (nvme_poll_cq(nvmeq, &iob)) {
 		if (!rq_list_empty(&iob.req_list))
 			nvme_pci_complete_batch(&iob);
+
+		// Do it only for threaded irq.
+		if(use_threaded_interrupts && nvme_irq_suppress && nvmeq->irq_suppressed) {
+			struct pci_dev *pdev = to_pci_dev(nvmeq->dev->dev);
+			spin_lock(&nvmeq->hybrid_poll_lock);
+			nvmeq->irq_suppressed = 0;
+			nvmeq->suppress_irq_count = nvme_irq_suppress;
+			enable_irq(pci_irq_vector(pdev, nvmeq->cq_vector));
+			spin_unlock(&nvmeq->hybrid_poll_lock);
+		}
+
 		return IRQ_HANDLED;
 	}
 	return IRQ_NONE;
@@ -2608,6 +2688,8 @@ static int nvme_alloc_queue(struct nvme_dev *dev, int qid, int depth)
 	nvmeq->min_io_size = 131072;
 	nvmeq->ave_io_size = 0;
 	dev->ctrl.queue_count++;
+	nvmeq->suppress_irq_count = NVME_IRQ_SUPPRESS_COUNT;
+	nvmeq->irq_suppressed = 0;
 
 	return 0;
 
@@ -4743,6 +4825,11 @@ static int __init nvme_init(void)
 	if (ret)
 		pr_err("Failed to create sysfs file: numa_opt_nocopy\n");
 
+	ret = sysfs_create_file(nvme_kobj, &nvme_irq_suppress_attr.attr);
+	if (ret)
+		pr_err("Failed to create sysfs file: nvme_irq_suppress\n");
+
+
 	coalesce_thread = kthread_run(coalesce_thread_function, NULL, "coalesce_thread");
 	if (IS_ERR(coalesce_thread)) {
 		pr_err(KERN_ERR "Failed to create nvme irq coalesce thread\n");
@@ -4781,6 +4868,7 @@ static void __exit nvme_exit(void)
 	sysfs_remove_file(nvme_kobj, &min_running_queues_attr.attr);
 	sysfs_remove_file(nvme_kobj, &numa_opt_enabled_attr.attr);
 	sysfs_remove_file(nvme_kobj, &numa_opt_nocopy_attr.attr);
+	sysfs_remove_file(nvme_kobj, &nvme_irq_suppress_attr.attr);
 	kobject_put(nvme_kobj);
 }
 
