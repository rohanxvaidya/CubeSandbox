@@ -1570,6 +1583,19 @@ static ssize_t numa_opt_nocopy_store(struct kobject *kobj, struct kobj_attribute
 	return ret ?: count;
 }
 
+static ssize_t nvme_irq_suppress_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf) {
+	return sprintf(buf, "%d\n", nvme_irq_suppress);
+}
+
+static ssize_t nvme_irq_suppress_store(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t count) {
+	int v = 0;
+	int ret = kstrtoint(buf, 10, &v);
+	if(0<=v && v<100000)
+		nvme_irq_suppress = v;
+	return ret ?: count;
+
+}
+
 static struct kobj_attribute disable_attr = __ATTR(disable, 0644, disable_show, disable_store);
 static struct kobj_attribute debug_attr = __ATTR(debug, 0644, debug_show, debug_store);
 static struct kobj_attribute switch_cnt_attr = __ATTR(switch_cnt, 0644, switch_cnt_show, switch_cnt_store);
@@ -1581,6 +1607,7 @@ static struct kobj_attribute min_completed_threshold_attr = __ATTR(min_completed
