 static struct kobj_attribute numa_opt_nocopy_attr = __ATTR(numa_opt_nocopy, 0644, numa_opt_nocopy_show, numa_opt_nocopy_store);
+static struct kobj_attribute nvme_irq_suppress_attr = __ATTR(nvme_irq_suppress, 0644, nvme_irq_suppress_show, nvme_irq_suppress_store);
 
 
