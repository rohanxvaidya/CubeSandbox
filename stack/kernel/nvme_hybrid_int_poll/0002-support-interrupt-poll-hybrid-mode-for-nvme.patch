     if (nvme_should_optimize_numa(dev, req, dev_numa_node)) {
-        return nvme_setup_numa_optimization(dev, req, cmnd, dev_numa_node);
+        ret = nvme_setup_numa_optimization(dev, req, cmnd, dev_numa_node);
+		if (ret == BLK_STS_OK)
+			return ret;
     } else {
