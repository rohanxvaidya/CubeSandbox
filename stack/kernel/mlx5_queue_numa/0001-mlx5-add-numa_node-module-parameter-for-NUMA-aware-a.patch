From 8779453c03749f7d92e2aaa272c1d025e7b9e9e1 Mon Sep 17 00:00:00 2001
From: mz <mz@localhost>
Date: Tue, 19 May 2026 23:28:19 -0400
Subject: [PATCH 1/3] mlx5: add numa_node module parameter for NUMA-aware
 allocations

Add a module parameter 'numa_node' that allows overriding the NUMA node
used for all driver memory allocations (EQ buffers, IRQ tables, UAR pages,
WQ buffers, etc.) and IRQ affinity.

When set, priv->numa_node is initialized to the specified node instead of
the PCI device's physical NUMA node. This causes all downstream allocation
paths to use the target NUMA node, including:
- IRQ table structure (pci_irq.c)
- EQ ring buffers and completion EQ structures (eq.c)
- UAR page bitmaps (uar.c)
- Comp IRQ CPU affinity spread (eq.c: comp_irq_request_pci)

Usage:
  modprobe mlx5_core numa_node=1  # allocate on NUMA node 1
  modprobe mlx5_core              # default: follow PCI topology

Signed-off-by: mz <mz@localhost>
---
 drivers/net/ethernet/mellanox/mlx5/core/main.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/main.c b/drivers/net/ethernet/mellanox/mlx5/core/main.c
index bccf6e53556c..fcce1bc99e7f 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/main.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/main.c
@@ -83,6 +83,10 @@ unsigned int mlx5_core_debug_mask;
 module_param_named(debug_mask, mlx5_core_debug_mask, uint, 0644);
 MODULE_PARM_DESC(debug_mask, "debug mask: 1 = dump cmd data, 2 = dump cmd exec time, 3 = both. Default=0");
 
+static int mlx5_numa_node = NUMA_NO_NODE;
+module_param_named(numa_node, mlx5_numa_node, int, 0444);
+MODULE_PARM_DESC(numa_node, "NUMA node for driver memory allocations (-1 = auto from PCI topology). Default=-1");
+
 static unsigned int prof_sel = MLX5_DEFAULT_PROF;
 module_param_named(prof_sel, prof_sel, uint, 0444);
 MODULE_PARM_DESC(prof_sel, "profile selector. Valid range 0 - 2");
@@ -1808,7 +1812,11 @@ int mlx5_mdev_init(struct mlx5_core_dev *dev, int profile_idx)
 	mutex_init(&priv->pgdir_mutex);
 	INIT_LIST_HEAD(&priv->pgdir_list);
 
-	priv->numa_node = dev_to_node(mlx5_core_dma_dev(dev));
+	if (mlx5_numa_node != NUMA_NO_NODE && mlx5_numa_node >= 0 &&
+	    mlx5_numa_node < nr_node_ids && node_online(mlx5_numa_node))
+		priv->numa_node = mlx5_numa_node;
+	else
+		priv->numa_node = dev_to_node(mlx5_core_dma_dev(dev));
 	priv->dbg.dbg_root = debugfs_create_dir(dev_name(dev->device),
 						mlx5_debugfs_root);
 	debugfs_create_file("vhca_id", 0400, priv->dbg.dbg_root, dev, &vhca_id_fops);
