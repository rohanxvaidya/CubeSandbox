From 4f3ac8f925001b16fd3a003bd3935515596888b0 Mon Sep 17 00:00:00 2001
From: mz <mz@localhost>
Date: Wed, 20 May 2026 01:40:07 -0400
Subject: [PATCH 2/3] mlx5: add per-queue NUMA node mapping via queue_numa
 parameter

Add module parameter 'queue_numa' that allows specifying per-queue NUMA
node for completion IRQ spreading and buffer allocation. Format is
range-based: 'start-end:node[,start-end:node,...]'

Example:
  modprobe mlx5_core queue_numa='0-9:0,10-62:1'

This assigns queues 0-9 to NUMA node 0 and queues 10-62 to NUMA node 1.
Each queue's completion IRQ is spread to a CPU on the specified NUMA node.
Since channel buffer allocations (RQ/SQ/CQ) already use cpu_to_node(c->cpu),
they automatically follow the IRQ's NUMA placement.

When queue_numa is not set or a queue index has no mapping, falls back to
the 'numa_node' parameter or PCI device topology.

Signed-off-by: mz <mz@localhost>
---
 drivers/net/ethernet/mellanox/mlx5/core/eq.c  | 28 +++++-
 .../net/ethernet/mellanox/mlx5/core/main.c    | 93 +++++++++++++++++++
 2 files changed, 117 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/eq.c b/drivers/net/ethernet/mellanox/mlx5/core/eq.c
index 40a6cb052a2d..33d041b3135d 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/eq.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/eq.c
@@ -871,9 +871,20 @@ static int comp_irq_request_pci(struct mlx5_core_dev *dev, u16 vecidx)
 	struct cpu_rmap *rmap;
 	struct mlx5_irq *irq;
 	int cpu;
+	int numa;
 
 	rmap = mlx5_eq_table_get_pci_rmap(dev);
-	cpu = mlx5_cpumask_default_spread(dev->priv.numa_node, vecidx);
+
+	/* Use per-queue NUMA map if configured for this vecidx */
+	extern int mlx5_queue_numa_map[];
+	extern int mlx5_queue_numa_map_len;
+	if (vecidx < mlx5_queue_numa_map_len &&
+	    mlx5_queue_numa_map[vecidx] != NUMA_NO_NODE)
+		numa = mlx5_queue_numa_map[vecidx];
+	else
+		numa = dev->priv.numa_node;
+
+	cpu = mlx5_cpumask_default_spread(numa, vecidx);
 	irq = mlx5_irq_request_vector(dev, cpu, vecidx, &rmap);
 	if (IS_ERR(irq))
 		return PTR_ERR(irq);
@@ -1133,12 +1144,21 @@ int mlx5_comp_vector_get_cpu(struct mlx5_core_dev *dev, int vector)
 {
 	struct cpumask *mask;
 	int cpu;
+	int numa;
 
 	mask = mlx5_comp_irq_get_affinity_mask(dev, vector);
-	if (mask)
+	if (mask) {
 		cpu = cpumask_first(mask);
-	else
-		cpu = mlx5_cpumask_default_spread(dev->priv.numa_node, vector);
+	} else {
+		extern int mlx5_queue_numa_map[];
+		extern int mlx5_queue_numa_map_len;
+		if (vector < mlx5_queue_numa_map_len &&
+		    mlx5_queue_numa_map[vector] != NUMA_NO_NODE)
+			numa = mlx5_queue_numa_map[vector];
+		else
+			numa = dev->priv.numa_node;
+		cpu = mlx5_cpumask_default_spread(numa, vector);
+	}
 
 	return cpu;
 }
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/main.c b/drivers/net/ethernet/mellanox/mlx5/core/main.c
index fcce1bc99e7f..e25a1354a92b 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/main.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/main.c
@@ -87,6 +87,98 @@ static int mlx5_numa_node = NUMA_NO_NODE;
 module_param_named(numa_node, mlx5_numa_node, int, 0444);
 MODULE_PARM_DESC(numa_node, "NUMA node for driver memory allocations (-1 = auto from PCI topology). Default=-1");
 
+#define MLX5_MAX_QUEUE_NUMA 256
+static char *mlx5_queue_numa;
+module_param_named(queue_numa, mlx5_queue_numa, charp, 0444);
+MODULE_PARM_DESC(queue_numa, "Per-queue NUMA node map, e.g. '0-9:0,10-62:1'. Overrides numa_node for comp IRQ spreading.");
+
+/* Per-queue NUMA node array: -1 means use default (numa_node or PCI topology) */
+int mlx5_queue_numa_map[MLX5_MAX_QUEUE_NUMA];
+int mlx5_queue_numa_map_len;
+
+static void mlx5_parse_queue_numa(void)
+{
+	char *str, *cur;
+	int start, end, node, i;
+
+	mlx5_queue_numa_map_len = 0;
+	for (i = 0; i < MLX5_MAX_QUEUE_NUMA; i++)
+		mlx5_queue_numa_map[i] = NUMA_NO_NODE;
+
+	if (!mlx5_queue_numa || !*mlx5_queue_numa)
+		return;
+
+	str = kstrdup(mlx5_queue_numa, GFP_KERNEL);
+	if (!str)
+		return;
+
+	cur = str;
+	while (cur && *cur) {
+		char *comma = strchr(cur, ',');
+		char *colon, *dash;
+
+		if (comma)
+			*comma = '\0';
+
+		/* Parse "start-end:node" or "start:node" */
+		colon = strchr(cur, ':');
+		if (!colon)
+			goto next;
+
+		*colon = '\0';
+		if (kstrtoint(colon + 1, 10, &node) || node < 0 ||
+		    node >= nr_node_ids || !node_online(node))
+			goto next;
+
+		dash = strchr(cur, '-');
+		if (dash) {
+			*dash = '\0';
+			if (kstrtoint(cur, 10, &start) || kstrtoint(dash + 1, 10, &end))
+				goto next;
+		} else {
+			if (kstrtoint(cur, 10, &start))
+				goto next;
+			end = start;
+		}
+
+		if (start < 0 || end < start || end >= MLX5_MAX_QUEUE_NUMA)
+			goto next;
+
+		for (i = start; i <= end; i++)
+			mlx5_queue_numa_map[i] = node;
+		if (end + 1 > mlx5_queue_numa_map_len)
+			mlx5_queue_numa_map_len = end + 1;
+next:
+		cur = comma ? comma + 1 : NULL;
+	}
+
+	kfree(str);
+
+	/* Print queue NUMA mapping summary */
+	if (mlx5_queue_numa_map_len > 0) {
+		int cur_node, run_start;
+
+		pr_info("mlx5_core: queue_numa mapping (%d queues):\n",
+			mlx5_queue_numa_map_len);
+		cur_node = mlx5_queue_numa_map[0];
+		run_start = 0;
+		for (i = 1; i <= mlx5_queue_numa_map_len; i++) {
+			int n = (i < mlx5_queue_numa_map_len) ?
+				mlx5_queue_numa_map[i] : -2;
+			if (n != cur_node) {
+				if (cur_node == NUMA_NO_NODE)
+					pr_info("mlx5_core:   queue %d-%d -> default\n",
+						run_start, i - 1);
+				else
+					pr_info("mlx5_core:   queue %d-%d -> NUMA %d\n",
+						run_start, i - 1, cur_node);
+				cur_node = n;
+				run_start = i;
+			}
+		}
+	}
+}
+
 static unsigned int prof_sel = MLX5_DEFAULT_PROF;
 module_param_named(prof_sel, prof_sel, uint, 0444);
 MODULE_PARM_DESC(prof_sel, "profile selector. Valid range 0 - 2");
@@ -2322,6 +2414,7 @@ static int __init mlx5_init(void)
 	get_random_bytes(&sw_owner_id, sizeof(sw_owner_id));
 
 	mlx5_core_verify_params();
+	mlx5_parse_queue_numa();
 	mlx5_register_debugfs();
 
 	err = mlx5e_init();
-- 
2.52.0

