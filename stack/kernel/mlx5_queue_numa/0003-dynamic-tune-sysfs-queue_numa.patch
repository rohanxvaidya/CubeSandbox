@@ -286,7 +286,7 @@ create_map_eq(struct mlx5_core_dev *dev, struct mlx5_eq *eq,
 	eq->cons_index = 0;
 
 	err = mlx5_frag_buf_alloc_node(dev, wq_get_byte_sz(log_eq_size, log_eq_stride),
-				       &eq->frag_buf, dev->priv.numa_node);
+				       &eq->frag_buf, param->numa_node);
 	if (err)
 		return err;
 
@@ -668,6 +668,7 @@ static int create_async_eqs(struct mlx5_core_dev *dev)
 	param = (struct mlx5_eq_param) {
 		.irq = table->ctrl_irq,
 		.nent = MLX5_NUM_CMD_EQE,
+		.numa_node = dev->priv.numa_node,
 		.mask[0] = 1ull << MLX5_EVENT_TYPE_CMD,
 	};
 	mlx5_cmd_allowed_opcode(dev, MLX5_CMD_OP_CREATE_EQ);
@@ -681,6 +682,7 @@ static int create_async_eqs(struct mlx5_core_dev *dev)
 	param = (struct mlx5_eq_param) {
 		.irq = table->ctrl_irq,
 		.nent = async_eq_depth_devlink_param_get(dev),
+		.numa_node = dev->priv.numa_node,
 	};
 
 	gather_async_events_mask(dev, param.mask);
@@ -691,6 +693,7 @@ static int create_async_eqs(struct mlx5_core_dev *dev)
 	param = (struct mlx5_eq_param) {
 		.irq = table->ctrl_irq,
 		.nent = /* TODO: sriov max_vf + */ 1,
+		.numa_node = dev->priv.numa_node,
 		.mask[0] = 1ull << MLX5_EVENT_TYPE_PAGE_REQUEST,
 	};
 
@@ -1018,6 +1021,7 @@ static int create_comp_eq(struct mlx5_core_dev *dev, u16 vecidx)
 	struct mlx5_eq_param param = {};
 	struct mlx5_eq_comp *eq;
 	struct mlx5_irq *irq;
+	int eq_node;
 	int nent;
 	int err;
 
@@ -1028,13 +1032,24 @@ static int create_comp_eq(struct mlx5_core_dev *dev, u16 vecidx)
 		return -ENOMEM;
 	}
 
+	/* Determine NUMA node for this comp EQ's allocations */
+	{
+		extern int mlx5_queue_numa_map[];
+		extern int mlx5_queue_numa_map_len;
+		if (vecidx < mlx5_queue_numa_map_len &&
+		    mlx5_queue_numa_map[vecidx] != NUMA_NO_NODE)
+			eq_node = mlx5_queue_numa_map[vecidx];
+		else
+			eq_node = dev->priv.numa_node;
+	}
+
 	err = comp_irq_request(dev, vecidx);
 	if (err)
 		return err;
 
 	nent = comp_eq_depth_devlink_param_get(dev);
 
-	eq = kzalloc_node(sizeof(*eq), GFP_KERNEL, dev->priv.numa_node);
+	eq = kzalloc_node(sizeof(*eq), GFP_KERNEL, eq_node);
 	if (!eq) {
 		err = -ENOMEM;
 		goto clean_irq;
@@ -1050,6 +1065,7 @@ static int create_comp_eq(struct mlx5_core_dev *dev, u16 vecidx)
 	param = (struct mlx5_eq_param) {
 		.irq = irq,
 		.nent = nent,
+		.numa_node = eq_node,
 	};
 
 	err = create_map_eq(dev, &eq->core, &param);
@@ -1104,6 +1120,28 @@ int mlx5_comp_eqn_get(struct mlx5_core_dev *dev, u16 vecidx, int *eqn)
 }
 EXPORT_SYMBOL(mlx5_comp_eqn_get);
 
+int mlx5_comp_eq_rebuild(struct mlx5_core_dev *dev, u16 vecidx)
+{
+	struct mlx5_eq_table *table = dev->priv.eq_table;
+	struct mlx5_eq_comp *eq;
+	int ret;
+
+	mutex_lock(&table->comp_lock);
+	eq = xa_load(&table->comp_eqs, vecidx);
+	if (!eq) {
+		/* EQ doesn't exist yet (lazy creation), just update map */
+		mutex_unlock(&table->comp_lock);
+		return 0;
+	}
+
+	destroy_comp_eq(dev, eq, vecidx);
+	ret = create_comp_eq(dev, vecidx);
+	mutex_unlock(&table->comp_lock);
+
+	return ret < 0 ? ret : 0;
+}
+EXPORT_SYMBOL(mlx5_comp_eq_rebuild);
