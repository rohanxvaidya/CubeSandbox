@@ -2072,6 +2287,8 @@ static void remove_one(struct pci_dev *pdev)
 	struct mlx5_core_dev *dev  = pci_get_drvdata(pdev);
 	struct devlink *devlink = priv_to_devlink(dev);
 
+	device_remove_file(&pdev->dev, &dev_attr_queue_numa);
