 #include <linux/mlx5/driver.h>
 #include <linux/mlx5/cq.h>
 #include <linux/mlx5/qp.h>
@@ -179,6 +181,214 @@ static void mlx5_parse_queue_numa(void)
 	}
 }
 
+static ssize_t queue_numa_show(struct device *device,
+			       struct device_attribute *attr, char *buf)
+{
+	int i, len = 0;
+	int run_start, cur_node;
+
+	if (mlx5_queue_numa_map_len == 0)
+		return sysfs_emit(buf, "(not configured)\n");
+
+	cur_node = mlx5_queue_numa_map[0];
+	run_start = 0;
+	for (i = 1; i <= mlx5_queue_numa_map_len; i++) {
+		int n = (i < mlx5_queue_numa_map_len) ?
+			mlx5_queue_numa_map[i] : -2;
+		if (n != cur_node) {
+			if (run_start == i - 1)
+				len += sysfs_emit_at(buf, len, "%d:%d",
+						     run_start, cur_node);
+			else
+				len += sysfs_emit_at(buf, len, "%d-%d:%d",
+						     run_start, i - 1, cur_node);
+			cur_node = n;
+			run_start = i;
+			if (i < mlx5_queue_numa_map_len)
+				len += sysfs_emit_at(buf, len, ",");
+		}
+	}
+	len += sysfs_emit_at(buf, len, "\n");
+	return len;
+}
+
+static ssize_t queue_numa_store(struct device *device,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct pci_dev *pdev = to_pci_dev(device);
+	struct mlx5_core_dev *dev = pci_get_drvdata(pdev);
+	struct net_device *netdev = NULL;
+	char *str, *cur;
+	int start, end, node, i;
+	int *new_map;
+	int new_len = 0;
+	bool need_rebuild = false;
+	bool was_up = false;
+
+	new_map = kvmalloc_array(MLX5_MAX_QUEUE_NUMA, sizeof(int), GFP_KERNEL);
+	if (!new_map)
+		return -ENOMEM;
+
+	/* Parse into temporary map first */
+	for (i = 0; i < MLX5_MAX_QUEUE_NUMA; i++)
+		new_map[i] = NUMA_NO_NODE;
+
+	str = kstrdup(buf, GFP_KERNEL);
+	if (!str) {
+		kvfree(new_map);
+		return -ENOMEM;
+	}
+
+	/* Strip trailing newline */
+	i = strlen(str);
+	if (i > 0 && str[i - 1] == '\n')
+		str[i - 1] = '\0';
+
+	if (!*str) {
+		kfree(str);
+		kvfree(new_map);
+		return -EINVAL;
+	}
+
+	cur = str;
+	while (cur && *cur) {
+		char *comma = strchr(cur, ',');
+		char *colon, *dash;
+
+		if (comma)
+			*comma = '\0';
+
+		colon = strchr(cur, ':');
+		if (!colon)
+			goto parse_next;
+
+		*colon = '\0';
+		if (kstrtoint(colon + 1, 10, &node) || node < 0 ||
+		    node >= nr_node_ids || !node_online(node))
+			goto parse_next;
+
+		dash = strchr(cur, '-');
+		if (dash) {
+			*dash = '\0';
+			if (kstrtoint(cur, 10, &start) || kstrtoint(dash + 1, 10, &end))
+				goto parse_next;
+		} else {
+			if (kstrtoint(cur, 10, &start))
+				goto parse_next;
+			end = start;
+		}
+
+		if (start < 0 || end < start || end >= MLX5_MAX_QUEUE_NUMA)
+			goto parse_next;
+
+		for (i = start; i <= end; i++)
+			new_map[i] = node;
+		if (end + 1 > new_len)
+			new_len = end + 1;
+parse_next:
+		cur = comma ? comma + 1 : NULL;
+	}
+	kfree(str);
+
+	if (new_len == 0) {
+		kvfree(new_map);
+		return -EINVAL;
+	}
+
+	/* Check if any queue actually needs NUMA change */
+	for (i = 0; i < new_len; i++) {
+		if (new_map[i] != mlx5_queue_numa_map[i]) {
+			need_rebuild = true;
+			break;
+		}
+	}
+
+	if (!need_rebuild) {
+		dev_info(&pdev->dev, "queue_numa: no changes needed\n");
+		kvfree(new_map);
+		return count;
+	}
+
+	/*
+	 * CRITICAL: Must close netdev BEFORE rebuilding EQs.
+	 * Channels use EQs for CQ completion; destroying an EQ while
+	 * a channel is active causes use-after-free and softlockup.
+	 */
+	mutex_lock(&dev->mlx5e_res.uplink_netdev_lock);
+	netdev = dev->mlx5e_res.uplink_netdev;
+	if (netdev)
+		dev_hold(netdev);
+	mutex_unlock(&dev->mlx5e_res.uplink_netdev_lock);
+
+	if (netdev && (netdev->flags & IFF_UP)) {
+		dev_info(&pdev->dev,
+			 "queue_numa: closing %s before EQ rebuild\n",
+			 netdev->name);
+		rtnl_lock();
+		dev_close(netdev);
+		rtnl_unlock();
+		was_up = true;
+	}
+
+	/* Update map length FIRST so comp_irq_request_pci sees the new values
+	 * during rebuild (it checks vecidx < mlx5_queue_numa_map_len).
+	 */
+	if (new_len > mlx5_queue_numa_map_len)
+		mlx5_queue_numa_map_len = new_len;
+
+	/* Now safe to rebuild EQs - no channels are using them */
+	for (i = 0; i < new_len; i++) {
+		if (new_map[i] != mlx5_queue_numa_map[i]) {
+			mlx5_queue_numa_map[i] = new_map[i];
+			if (mlx5_comp_eq_rebuild(dev, i))
+				dev_warn(&pdev->dev,
+					 "queue_numa: EQ %d rebuild failed\n", i);
+		}
+	}
+	mlx5_queue_numa_map_len = new_len;
+	kvfree(new_map);
+
+	/* Reopen netdev if it was UP - channels will use new NUMA/CPUs */
+	if (was_up && netdev) {
+		int num_queues, qi;
+
+		dev_info(&pdev->dev,
+			 "queue_numa: reopening %s after EQ rebuild\n",
+			 netdev->name);
+		rtnl_lock();
+		dev_open(netdev, NULL);
+
+		/* Update XPS to match new IRQ affinities.
+		 * Without this, cores whose comp vector moved will have no XPS
+		 * mapping and fall back to hash-based queue selection, causing
+		 * TX and NAPI completion to run on different cores (SQ HITM).
+		 */
+		num_queues = min_t(int, netdev->real_num_tx_queues,
+				   mlx5_comp_vectors_max(dev));
+		for (qi = 0; qi < num_queues; qi++) {
+			int cpu = mlx5_comp_vector_get_cpu(dev, qi);
+
+			if (cpu >= nr_cpu_ids)
+				continue;
+			netif_set_xps_queue(netdev, cpumask_of(cpu), qi);
+		}
+		dev_info(&pdev->dev,
+			 "queue_numa: updated XPS for %d queues\n", num_queues);
+
+		rtnl_unlock();
+	}
+
+	if (netdev)
+		dev_put(netdev);
+
+	dev_info(&pdev->dev, "queue_numa: updated %d queues\n",
+		 mlx5_queue_numa_map_len);
+	return count;
+}
+
+static DEVICE_ATTR_RW(queue_numa);
+
